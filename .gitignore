# ==============================================================================
# SPCart — Security & Production GitIgnore Policy
# Prevents sensitive credentials, API keys, local databases, and temporary files
# from being committed to version control or deployment repositories.
# ==============================================================================

# ── Environment & Security Credentials ─────────────────────────────────────────
.env
.env.*
*.env
*.pem
*.key
*.cert
*.crt
secrets.json
credentials.json

# ── Python Cache & Compiled Files ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
wheels/
*.egg-link
.installed.cfg
*.manifest
*.spec

# ── Virtual Environments ───────────────────────────────────────────────────────
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ── Local Databases & SQL Dumps ────────────────────────────────────────────────
db.sqlite3
db.sqlite3-journal
db.sqlite3-shm
db.sqlite3-wal
*.sqlite3
*.db
*.sql
*.dump

# ── Media Uploads & Temporary Storage ──────────────────────────────────────────
# Allow product & brand images (seeded, part of project)
media/*
!media/products/
!media/products/**
!media/brands/
!media/brands/**
staticfiles/
*.log

# ── Operating System & Editor Files ────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── IDEs & Code Editors ────────────────────────────────────────────────────────
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.idea/
*.iws
*.iml
*.ipr

# ── Testing & Coverage ────────────────────────────────────────────────────────
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
.pytest_cache/
.tox/

# ── Antigravity / AI Agent Artifacts & System Logs ────────────────────────────
.gemini/
scratch/
*.jsonl
