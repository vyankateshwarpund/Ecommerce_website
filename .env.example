# ==============================================================================
# SPCart — Environment Variables Configuration Example Template
# Copy this file to '.env' and fill in your actual production/development credentials.
# NEVER commit the actual '.env' file to Git!
# ==============================================================================

# Django Secret Key & Debug Mode
SECRET_KEY=django-insecure-your-secret-key-goes-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration (MySQL / SQLite)
USE_MYSQL=True
DB_NAME=spcart_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_HOST=127.0.0.1
DB_PORT=3307

# Gmail SMTP Email Credentials
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password_here
DEFAULT_FROM_EMAIL="SPCart Team <your_email@gmail.com>"

# Razorpay Online Payment Gateway Credentials
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
